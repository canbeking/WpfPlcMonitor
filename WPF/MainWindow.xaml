<Window x:Class="WpfPlcMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="工业实时监控系统" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：标题 -->
        <TextBlock Text="工业智能监控中心" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#333" Margin="0,0,0,10"/>

        <!-- 中部：左边是当前数值卡片，右边是折线图 -->
        <Grid Grid.Row="1" Margin="0,10,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：当前数值显示区 -->
            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                <!-- 温度卡片 -->
                <Border Background="#F0F4F8" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="实时温度 (Temperature)" Foreground="Gray" FontSize="13"/>
                        <TextBlock x:Name="txtTemp" Text="-- °C" FontSize="32" FontWeight="Bold" Foreground="#007ACC" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 湿度卡片 -->
                <Border Background="#F0F4F8" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="实时湿度 (Humidity)" Foreground="Gray" FontSize="13"/>
                        <TextBlock x:Name="txtHumidity" Text="-- %" FontSize="26" FontWeight="Bold" Foreground="#28A745" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 状态卡片 -->
                <Border Background="#F0F4F8" CornerRadius="8" Padding="15">
                    <StackPanel>
                        <TextBlock Text="设备运行状态 (Status)" Foreground="Gray" FontSize="13"/>
                        <TextBlock x:Name="txtStatus" Text="状态: 离线" FontSize="20" FontWeight="Bold" Foreground="Gray" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 右侧：控制面板与 ScottPlot 折线图组合 -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- 上方：历史查询控制面板 -->
                    <RowDefinition Height="*"/>
                    <!-- 下方：折线图控件 -->
                </Grid.RowDefinitions>

                <!-- 1. 历史数据查询控制面板 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                    <TextBlock Text="开始时间: " VerticalAlignment="Center" Margin="0,0,5,0" FontSize="12"/>
                    <DatePicker x:Name="dpStart" Width="120" Margin="0,0,10,0"/>

                    <TextBlock Text="结束时间: " VerticalAlignment="Center" Margin="0,0,5,0" FontSize="12"/>
                    <DatePicker x:Name="dpEnd" Width="120" Margin="0,0,10,0"/>

                    <Button x:Name="btnQuery" Content=" 历史查询 " Width="75" Height="25" Background="#007ACC" Foreground="White" Click="BtnQuery_Click"/>
                    <Button x:Name="btnReset" Content=" 返回实时 " Width="75" Height="25" Margin="8,0,0,0" Click="BtnReset_Click"/>
                </StackPanel>

                <!-- 2. ScottPlot 折线图控件（放在一个 Border 里美化） -->
                <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" Background="White" Padding="5">
                    <wpf:WpfPlot x:Name="pltTemperature" MouseMove="pltTemperature_MouseMove"/>
                </Border>
            </Grid>
        </Grid>

        <!-- 底部：状态栏 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0">
            <!-- 原有的运行状态 -->
            <TextBlock x:Name="txtLogStatus" Text="状态: 正常运行中 | 初始化完成" Foreground="Gray" FontSize="12"/>

            <!-- 中间加个分隔符或间距 -->
            <TextBlock Text="   |   " Foreground="LightGray" FontSize="12"/>

            <!-- 新增的光标追踪实时数据 -->
            <TextBlock x:Name="txtCursorInfo" Text="光标提示: 请将鼠标移入图表" Foreground="#007ACC" FontSize="12"/>
        </StackPanel>
    </Grid>
</Window>